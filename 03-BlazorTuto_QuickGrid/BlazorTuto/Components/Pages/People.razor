@page "/people"
@using BlazorTuto.Models
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer

<h3>People</h3>

@if(people == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="grid">
        <QuickGrid Items="@FilteredPeople" Pagination="@pagination">
            <PropertyColumn Property="@(p => p.BusinessEntityID)" Sortable="true" />
            <PropertyColumn Property="@(p => p.Title)" Sortable="true" />
            <PropertyColumn Property="@(p => p.FirstName)" Sortable="true">              
                <ColumnOptions>
                    <div class="search-box">
                        <input type="search" autofocus @bind="nameFilter" @bind:event="oninput" placeholder="first name..." />
                    </div>
                </ColumnOptions>
            </PropertyColumn>
            <PropertyColumn Property="@(p => p.LastName)" Sortable="true" />
            <PropertyColumn Property="@(p => p.ModifiedDate)" Sortable="true" Format="dd-MM-yyyy" />
        </QuickGrid>
    </div>

    <Paginator State="@pagination"></Paginator>
}

@code {
    IQueryable<Person> people = null;

    string nameFilter = string.Empty;

    PaginationState pagination = new PaginationState { ItemsPerPage = 12 };

    IQueryable<Person> FilteredPeople => 
        string.IsNullOrWhiteSpace(nameFilter) 
            ? people 
            : people.Where(p => p.FirstName.Contains(nameFilter, StringComparison.OrdinalIgnoreCase));  

    [Inject]
    public AdventureContext Context { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var result = await Context.People.ToListAsync();

        people = result.AsQueryable();
    }

}
